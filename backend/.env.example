# ---------------------------------------------------------------
# GymFlow backend configuration
# Copy to  ./backend/.env   (or  ./.env  — both are read)
# ---------------------------------------------------------------

# HTTP port the bridge listens on (0.0.0.0)
PORT=8787

# Public URL of THIS backend (used to build the UPI return URL).
# Leave empty to auto-detect from the request headers.
PUBLIC_BASE_URL=

# 'youpi' = real UPI payments through your self-hosted YOUPI PG instance
# 'mock'  = fake gateway for demos / preview (no money moves)
PAYMENT_PROVIDER=mock

# ---------------- Direct UPI collection -----------------------------
# Money is collected straight into this UPI ID (your own bank account, 0% fee).
# This is the value the app shows in the QR code and the upi:// deep link.
MERCHANT_UPI_ID=8089274532@axl
# Name shown in the customer's UPI app while paying
MERCHANT_NAME=GymFlow
# Merchant category code (7994 = fitness/recreation services); optional
MERCHANT_MCC=7994
# How long a payment order stays open before it is considered abandoned
UPI_ORDER_TTL_MINUTES=180

# Token for the merchant console at /admin where you approve UTRs by hand
# when no bank observer is running yet. Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ---------------- YOUPI PG (https://github.com/youpi-pg/YouPI-PG) ----------
# Base URL of the YOUPI payment API (their default local port is 6100)
YOUPI_API_URL=http://localhost:6100
# Base URL of the YOUPI hosted checkout portal (their default local port is 7000)
YOUPI_PORTAL_URL=http://localhost:7000
# Merchant UUID from the YOUPI merchant admin panel -> sent as X-Merchant-Id
YOUPI_MERCHANT_ID=
# Merchant webhook/API secret -> sent as X-Merchant-Key AND used to verify
# the sha256= HMAC signature on incoming webhooks
YOUPI_MERCHANT_SECRET=
# Where the customer lands after paying (leave empty to use <base>/paid.html)
YOUPI_RETURN_URL=

# Unlock Pro as soon as YOUPI's observers match a bank alert ('observed')
# or only after the merchant imports & reconciles a bank statement ('reconciled').
# 'observed' = instant but a bank statement has not confirmed it yet.
GRANT_ON=observed

# Secret used to sign Pro licence keys (scripts/gen-license.mjs).
# CHANGE THIS before issuing real keys.
LICENSE_SECRET=change-me-gymflow-license-secret

# Where orders/entitlements/sync blobs are stored
DATA_DIR=./backend/data
